{
  "name": "jani",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "packs": "node ../scripts/build-packs.mjs",
    "predev": "npm run packs",
    "prebuild": "npm run packs",
    "postinstall": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "check:assets": "node scripts/check-assets.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "cd android && gradlew.bat assembleDebug",
    "e2e:install": "node scripts/e2e.mjs install"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/core": "^7.6.9",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
